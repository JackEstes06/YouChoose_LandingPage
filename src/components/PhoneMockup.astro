---
/**
 * Hero visual: a phone showing the swipe-to-match moment.
 *
 * Built from HTML + inline SVG rather than a bitmap so it stays crisp on
 * retina screens, weighs almost nothing, needs no external image host, and
 * can be re-colored from the CSS tokens. Decorative — hidden from screen
 * readers, with the meaning carried by the hero copy instead.
 */
---

<div class="phone-stage" aria-hidden="true">
  <!-- Ambient glows behind the device -->
  <span class="stage-glow stage-glow-a"></span>
  <span class="stage-glow stage-glow-b"></span>

  <div class="phone">
    <!-- Floating "both of you liked it" chips, anchored to the device -->
    <div class="chip chip-1">
      <span class="chip-dot"></span> Sam liked this too
    </div>
    <div class="chip chip-2">
      <span class="chip-star">★</span> 94% your taste
    </div>

    <div class="phone-screen">
      <!-- App chrome -->
      <header class="app-bar">
        <div class="pair">
          <span class="avatar avatar-a">J</span>
          <span class="avatar avatar-b">S</span>
          <span class="pair-label">You &amp; Sam</span>
        </div>
        <span class="app-cat">Dinner tonight</span>
      </header>

      <!-- Card stack -->
      <div class="cards">
        <div class="card card-back-2"></div>
        <div class="card card-back-1"></div>

        <article class="card card-front">
          <div class="card-art">
            <svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" role="presentation" focusable="false">
              <defs>
                <linearGradient id="artSky" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#1b2a5e" />
                  <stop offset="55%" stop-color="#2b1f63" />
                  <stop offset="100%" stop-color="#13234f" />
                </linearGradient>
                <linearGradient id="artNeon" x1="0" y1="1" x2="1" y2="0">
                  <stop offset="0%" stop-color="#2ee6c4" />
                  <stop offset="100%" stop-color="#7d6bff" />
                </linearGradient>
              </defs>
              <rect width="320" height="200" fill="url(#artSky)" />
              <!-- skyline -->
              <g opacity="0.5" fill="#0a1030">
                <rect x="6" y="108" width="34" height="92" />
                <rect x="46" y="86" width="26" height="114" />
                <rect x="78" y="120" width="40" height="80" />
                <rect x="124" y="72" width="30" height="128" />
                <rect x="160" y="112" width="36" height="88" />
                <rect x="202" y="92" width="28" height="108" />
                <rect x="236" y="124" width="44" height="76" />
                <rect x="286" y="100" width="30" height="100" />
              </g>
              <!-- lit windows -->
              <g fill="#2ee6c4" opacity="0.75">
                <rect x="52" y="96" width="4" height="6" />
                <rect x="62" y="110" width="4" height="6" />
                <rect x="132" y="84" width="4" height="6" />
                <rect x="142" y="104" width="4" height="6" />
                <rect x="210" y="104" width="4" height="6" />
                <rect x="248" y="136" width="4" height="6" />
              </g>
              <g fill="#ff5f9e" opacity="0.6">
                <rect x="16" y="122" width="4" height="6" />
                <rect x="90" y="134" width="4" height="6" />
                <rect x="170" y="126" width="4" height="6" />
                <rect x="296" y="114" width="4" height="6" />
              </g>
              <!-- street glow -->
              <rect x="0" y="176" width="320" height="24" fill="url(#artNeon)" opacity="0.22" />
              <!-- plate + steam mark -->
              <circle cx="160" cy="150" r="26" fill="none" stroke="url(#artNeon)" stroke-width="2.5" opacity="0.9" />
              <circle cx="160" cy="150" r="13" fill="none" stroke="#eef1fc" stroke-width="1.6" opacity="0.55" />
            </svg>
          </div>

          <div class="card-body">
            <span class="card-tag">Restaurant · 8 min away</span>
            <h3 class="card-title">Mediterranean small plates</h3>
            <p class="card-meta">$$ · Open till 10pm · Veg-friendly</p>
          </div>

          <!-- The swipe verdict stamp -->
          <span class="stamp">LIKE</span>
        </article>
      </div>

      <!-- The match confirmation, sitting between the card and the controls -->
      <div class="match-toast">
        <span class="match-burst">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 13l5 5L20 6" />
          </svg>
        </span>
        <span class="match-text">
          <strong>It's a match</strong>
          <em>You both said yes — table for 2 at 7:30?</em>
        </span>
      </div>

      <!-- Swipe controls -->
      <div class="controls">
        <button class="ctrl ctrl-no" type="button" tabindex="-1">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
        <button class="ctrl ctrl-wild" type="button" tabindex="-1">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l2.1 4.9 5.3.5-4 3.5 1.2 5.2L12 14.8 7.4 17.1l1.2-5.2-4-3.5 5.3-.5z" />
          </svg>
        </button>
        <button class="ctrl ctrl-yes" type="button" tabindex="-1">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 13l5 5L20 6" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .phone-stage {
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
    padding-block: 1.5rem;
  }

  .stage-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    z-index: -1;
  }
  .stage-glow-a {
    width: 58%;
    aspect-ratio: 1;
    background: rgba(46, 230, 196, 0.3);
    top: 2%;
    left: -8%;
  }
  .stage-glow-b {
    width: 62%;
    aspect-ratio: 1;
    background: rgba(125, 107, 255, 0.34);
    bottom: 0%;
    right: -10%;
  }

  /* ---------- Device ---------- */
  .phone {
    position: relative;
    width: min(310px, 78vw);
    aspect-ratio: 310 / 620;
    background: linear-gradient(160deg, #262f57, #101633 40%, #1b2346);
    border-radius: 42px;
    padding: 11px;
    box-shadow:
      0 0 0 1px rgba(160, 178, 240, 0.22),
      0 40px 80px -30px rgba(0, 0, 0, 0.95),
      0 0 70px -20px rgba(125, 107, 255, 0.5);
  }

  .phone-screen {
    position: relative;
    height: 100%;
    border-radius: 32px;
    background: radial-gradient(120% 80% at 50% 0%, #131a3c 0%, #090d20 70%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 1.1rem 0.9rem 1rem;
    gap: 0.85rem;
  }

  /* notch */
  .phone-screen::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 74px;
    height: 6px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.14);
  }

  /* ---------- App bar ---------- */
  .app-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.55rem;
    gap: 0.5rem;
  }

  .pair {
    display: flex;
    align-items: center;
  }

  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.66rem;
    font-weight: 800;
    color: #07132a;
    border: 2px solid #0b1024;
  }
  .avatar-a {
    background: var(--c-neon);
  }
  .avatar-b {
    background: var(--c-violet);
    color: #f2f0ff;
    margin-left: -8px;
  }
  .pair-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--c-text-muted);
    margin-left: 0.45rem;
  }

  .app-cat {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-neon);
    background: rgba(46, 230, 196, 0.12);
    border: 1px solid rgba(46, 230, 196, 0.3);
    padding: 0.22rem 0.5rem;
    border-radius: 99px;
  }

  /* ---------- Cards ---------- */
  .cards {
    position: relative;
    flex: 1;
    min-height: 0;
  }

  .card {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    background: var(--c-surface);
    border: 1px solid rgba(160, 178, 240, 0.16);
    overflow: hidden;
  }

  .card-back-2 {
    transform: rotate(6deg) translateY(10px) scale(0.94);
    opacity: 0.35;
  }
  .card-back-1 {
    transform: rotate(-3.5deg) translateY(5px) scale(0.97);
    opacity: 0.6;
  }

  .card-front {
    display: flex;
    flex-direction: column;
    transform: rotate(-1.5deg);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.9);
  }

  .card-art {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .card-art svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: 0.7rem 0.85rem 0.9rem;
    background: linear-gradient(180deg, rgba(17, 23, 54, 0.6), var(--c-surface) 40%);
  }

  .card-tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-neon);
  }
  .card-title {
    font-size: 0.98rem;
    margin: 0.2rem 0 0.22rem;
    letter-spacing: -0.02em;
  }
  .card-meta {
    font-size: 0.72rem;
    color: var(--c-text-dim);
    line-height: 1.3;
  }

  .stamp {
    position: absolute;
    top: 14px;
    right: 12px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--c-neon);
    border: 2.5px solid var(--c-neon);
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    transform: rotate(11deg);
    background: rgba(7, 10, 23, 0.55);
  }

  /* ---------- Controls ---------- */
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding-bottom: 0.2rem;
  }

  .ctrl {
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(160, 178, 240, 0.2);
    background: rgba(255, 255, 255, 0.05);
    width: 44px;
    height: 44px;
    padding: 0;
    pointer-events: none;
  }
  .ctrl svg {
    width: 20px;
    height: 20px;
  }
  .ctrl-no {
    color: #8e9ac4;
  }
  .ctrl-wild {
    color: var(--c-violet);
    width: 38px;
    height: 38px;
    border-color: rgba(125, 107, 255, 0.4);
    background: rgba(125, 107, 255, 0.14);
  }
  .ctrl-wild svg {
    width: 17px;
    height: 17px;
  }
  .ctrl-yes {
    color: var(--c-on-neon);
    background: var(--c-neon);
    border-color: transparent;
    box-shadow: 0 6px 20px -6px rgba(46, 230, 196, 0.8);
  }

  /* ---------- Match toast ---------- */
  .match-toast {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    border-radius: 15px;
    background: linear-gradient(120deg, rgba(46, 230, 196, 0.97), rgba(125, 107, 255, 0.97));
    color: #061225;
    box-shadow: 0 18px 40px -14px rgba(46, 230, 196, 0.7);
  }

  .match-burst {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(6, 18, 37, 0.92);
    color: var(--c-neon);
    display: grid;
    place-items: center;
  }
  .match-burst svg {
    width: 15px;
    height: 15px;
  }

  .match-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }
  .match-text strong {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .match-text em {
    font-size: 0.68rem;
    font-style: normal;
    opacity: 0.78;
  }

  /* ---------- Floating chips ---------- */
  .chip {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--c-text);
    background: rgba(17, 23, 54, 0.86);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(160, 178, 240, 0.24);
    padding: 0.45rem 0.7rem;
    border-radius: 99px;
    box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.9);
    white-space: nowrap;
  }

  .chip-1 {
    top: 30%;
    right: -13%;
    animation: float 6s ease-in-out infinite;
  }
  .chip-2 {
    bottom: 47%;
    left: -13%;
    animation: float 7.5s ease-in-out infinite reverse;
  }

  .chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-neon);
    box-shadow: 0 0 0 3px rgba(46, 230, 196, 0.22);
  }
  .chip-star {
    color: var(--c-violet);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  /* On narrow screens there's no room to hang the chips outside the
     device, so tuck them back over its edges instead of letting them
     run off the side of the page. */
  @media (max-width: 620px) {
    .chip {
      font-size: 0.68rem;
      padding: 0.38rem 0.6rem;
    }
    .chip-1 {
      right: -4%;
      top: 28%;
    }
    .chip-2 {
      left: -4%;
      bottom: 45%;
    }
  }

  @media (max-width: 380px) {
    .chip-1 {
      right: 0;
    }
    .chip-2 {
      left: 0;
    }
  }
</style>
