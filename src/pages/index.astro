---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import SignupForm from '../components/SignupForm.astro';
import StoreBadges from '../components/StoreBadges.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import { site, hero, steps, features, strip, categories, faqs, signup } from '../data/site';
---

<BaseLayout>
  <span id="top"></span>
  <Nav />

  <main>
    <!-- ══════════════════════════════════════════════════════════════
         HERO — everything essential sits above the fold:
         headline, one-line benefit, the email CTA, and the visual.
         Text sits left so the eye starts where English readers start.
         ══════════════════════════════════════════════════════════════ -->
    <section class="hero">
      <span class="glow hero-glow-a"></span>
      <span class="glow hero-glow-b"></span>

      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 class="hero-title">
            Never say <span class="hl">"I don't know, you choose"</span> again
          </h1>

          <p class="lead hero-sub">{hero.subhead}</p>

          <!-- Primary CTA, above the fold, highest-contrast element on the page -->
          <div class="hero-cta">
            <SignupForm id="signup-hero" variant="compact" />
          </div>

          <ul class="proof">
            {
              hero.proofPoints.map((point) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 13l5 5L20 6" />
                  </svg>
                  {point}
                </li>
              ))
            }
          </ul>

          <div class="hero-stores">
            <StoreBadges compact />
          </div>
        </div>

        <div class="hero-visual">
          <PhoneMockup />
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         CATEGORY STRIP — shows breadth in one glance, no reading required
         ══════════════════════════════════════════════════════════════ -->
    <section class="strip" aria-label="Who it's for and what it covers">
      <div class="wrap strip-head">
        <p class="strip-audience">
          <span class="strip-dot" aria-hidden="true"></span>
          {strip.audience}
        </p>
        <p class="strip-label">{strip.label}</p>
      </div>


      {/* Continuous marquee. The list is rendered twice and the track is
          translated exactly one copy's width, so the loop is seamless with
          no jump. Each group carries its own trailing gap so -50% lands
          precisely on the seam. Hover or keyboard focus pauses it; with
          reduced motion the animation is off and the row scrolls by hand. */}
      <div class="marquee">
        <div class="marquee-track">
          <ul class="marquee-group">
            {categories.map((category) => <li class="cat">{category}</li>)}
          </ul>
          <ul class="marquee-group" aria-hidden="true">
            {categories.map((category) => <li class="cat">{category}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         HOW IT WORKS
         ══════════════════════════════════════════════════════════════ -->
    <section class="section" id="how">
      <div class="wrap">
        <div class="section-head">
          <h2>Three taps from "I'm hungry" to a plan</h2>
          <p class="lead">
            No group poll. No spreadsheet. No one stuck being the person who has
            to decide for everybody.
          </p>
        </div>

        <ol class="steps">
          {
            steps.map((step) => (
              <li class="step">
                <span class="step-num">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         WHY IT WORKS — the differentiators vs. a random picker
         ══════════════════════════════════════════════════════════════ -->
    <section class="section why" id="why">
      <span class="glow why-glow"></span>
      <div class="wrap">
        <div class="section-head">
          <h2>A coin flip doesn't know either of you</h2>
          <p class="lead">
            {site.name} only ever suggests things you've <em>both</em> said yes to
            — and it gets sharper every single time you open it.
          </p>
        </div>

        <ul class="features">
          {
            features.map((feature) => (
              <li class="feature">
                <FeatureIcon name={feature.icon} />
                <div>
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         PRIMARY CONVERSION BLOCK — the CTA you cannot miss
         ══════════════════════════════════════════════════════════════ -->
    <section class="section cta" id="signup">
      <div class="wrap">
        <div class="cta-card">
          <span class="glow cta-glow-a"></span>
          <span class="glow cta-glow-b"></span>

          <div class="cta-inner">
            <p class="eyebrow">Early access · opening in waves</p>
            <h2 class="cta-title">{signup.heading}</h2>
            <p class="lead cta-sub">{signup.subheading}</p>

            <SignupForm id="signup-main" variant="full" />

            <div class="cta-stores">
              <p class="cta-stores-label">Launching on both stores</p>
              <StoreBadges />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         FAQ
         ══════════════════════════════════════════════════════════════ -->
    <section class="section faq" id="faq">
      <div class="wrap faq-grid">
        <div class="section-head faq-head">
          <h2>Quick answers</h2>
          <p class="lead">
            Still curious about something? Email
            <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> and a
            real person will reply.
          </p>
        </div>

        <div class="faq-list">
          {
            faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  {faq.q}
                  <span class="faq-mark" aria-hidden="true"></span>
                </summary>
                <p>{faq.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ══════════════════════ HERO ══════════════════════ */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.25rem, 5vw, 4.5rem) clamp(3rem, 7vw, 5.5rem);
    background:
      radial-gradient(90% 60% at 70% -5%, rgba(125, 107, 255, 0.16), transparent 60%),
      radial-gradient(70% 50% at 5% 10%, rgba(46, 230, 196, 0.11), transparent 60%),
      var(--c-bg);
  }

  .hero-glow-a {
    width: 520px;
    height: 520px;
    background: rgba(125, 107, 255, 0.16);
    top: -180px;
    right: -120px;
  }
  .hero-glow-b {
    width: 420px;
    height: 420px;
    background: rgba(46, 230, 196, 0.12);
    bottom: -200px;
    left: -140px;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.5rem);
    align-items: center;
  }

  /* Two columns only when there's genuinely room; text-first on mobile. */
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  .hero-copy {
    max-width: 40rem;
  }

  .hero-title {
    font-size: var(--fs-display);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 1.15rem 0 0;
  }

  .hero-sub {
    margin-top: 1.15rem;
    max-width: 33rem;
  }

  .hero-cta {
    margin-top: clamp(1.6rem, 3vw, 2.1rem);
    max-width: 32rem;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.35rem;
    margin-top: 1.4rem;
  }

  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-size: 0.86rem;
    font-weight: 550;
    color: var(--c-text-muted);
  }

  .proof svg {
    width: 14px;
    height: 14px;
    color: var(--c-neon);
    flex: none;
  }

  .hero-stores {
    margin-top: 1.8rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }

  .hero-visual {
    display: grid;
    place-items: center;
  }

  /* ══════════════════════ CATEGORY STRIP ══════════════════════ */
  /* The band under the hero answers "is this for me?" first, then
     "what does it cover?" — the audience line leads, the chips follow. */
  .strip {
    border-block: 1px solid var(--c-border);
    background: var(--c-bg-2);
    padding-block: clamp(1.9rem, 4vw, 2.6rem);
  }

  /* Audience line, then a plain sentence naming what the row below is.
     Stacked and left-aligned so the label reads as a caption for the
     categories rather than as a control hint floating off to the side. */
  .strip-head {
    display: grid;
    gap: 0.8rem;
    margin-bottom: clamp(1.1rem, 2.5vw, 1.5rem);
  }

  .strip-audience {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: clamp(1.02rem, 0.95rem + 0.4vw, 1.18rem);
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.45;
    color: var(--c-text);
    max-width: 26rem;
  }

  .strip-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-neon);
    box-shadow: 0 0 0 4px rgba(46, 230, 196, 0.16);
    transform: translateY(-2px);
  }

  .strip-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.94rem;
    font-weight: 550;
    color: var(--c-text-muted);
    margin: 0;
  }

  /* ---- Rotating category marquee ---- */
  .marquee {
    --marquee-gap: 0.75rem;
    --marquee-duration: 42s;
    position: relative;
    overflow: hidden;
    /* Fade both ends so chips enter and leave rather than being cut off. */
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    gap: var(--marquee-gap);
    /* The trailing gap belongs to the group, so one copy's width is an
       exact half of the track and the -50% translate has no seam. */
    padding-right: var(--marquee-gap);
  }

  @keyframes marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Pause on hover, and on keyboard focus anywhere inside. */
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  .cat {
    font-size: clamp(0.92rem, 0.88rem + 0.18vw, 1.02rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--c-text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    padding: 0.62rem 1.3rem;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .marquee:hover .cat {
    border-color: var(--c-border-strong);
  }

  .cat:hover {
    color: var(--c-text);
    background: rgba(46, 230, 196, 0.09);
    border-color: rgba(46, 230, 196, 0.45);
  }

  /* No motion: stop the animation and let the row be scrolled by hand
     so every category is still reachable. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      scrollbar-width: thin;
    }
    .marquee-track {
      animation: none;
    }
  }

  /* ══════════════════════ STEPS ══════════════════════ */
  .steps {
    display: grid;
    gap: 1.1rem;
    counter-reset: step;
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .step {
    position: relative;
    background: linear-gradient(180deg, var(--c-surface), rgba(17, 23, 54, 0.45));
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 1.6rem 1.5rem 1.7rem;
    box-shadow: var(--shadow-card);
  }

  .step-num {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--c-neon);
    background: rgba(46, 230, 196, 0.1);
    border: 1px solid rgba(46, 230, 196, 0.28);
    border-radius: 9px;
    padding: 0.22rem 0.55rem;
    margin-bottom: 1rem;
  }

  .step h3 {
    font-size: var(--fs-h3);
    margin-bottom: 0.55rem;
  }

  .step p {
    color: var(--c-text-muted);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  /* ══════════════════════ FEATURES ══════════════════════ */
  .why {
    position: relative;
    overflow: hidden;
    background: var(--c-bg-2);
    border-block: 1px solid var(--c-border);
  }

  .why-glow {
    width: 620px;
    height: 620px;
    background: rgba(125, 107, 255, 0.1);
    top: -260px;
    right: -180px;
  }

  .why .wrap {
    position: relative;
    z-index: 1;
  }

  .section-head em {
    font-style: normal;
    color: var(--c-neon);
    font-weight: 650;
  }

  .features {
    display: grid;
    gap: 1.15rem;
  }

  @media (min-width: 640px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .features {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.35rem;
    }
  }

  .feature {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: rgba(17, 23, 54, 0.6);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 1.4rem 1.35rem 1.5rem;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .feature:hover {
    border-color: var(--c-border-strong);
    transform: translateY(-2px);
  }

  .feature h3 {
    font-size: 1.02rem;
    margin-bottom: 0.45rem;
  }

  .feature p {
    color: var(--c-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* ══════════════════════ CTA ══════════════════════ */
  .cta-card {
    position: relative;
    overflow: hidden;
    border-radius: clamp(22px, 4vw, 34px);
    border: 1px solid rgba(46, 230, 196, 0.3);
    background:
      radial-gradient(100% 100% at 100% 0%, rgba(125, 107, 255, 0.22), transparent 60%),
      radial-gradient(80% 90% at 0% 100%, rgba(46, 230, 196, 0.16), transparent 60%),
      var(--c-surface);
    box-shadow: var(--glow-violet);
  }

  .cta-glow-a {
    width: 420px;
    height: 420px;
    background: rgba(46, 230, 196, 0.16);
    top: -180px;
    left: -120px;
  }
  .cta-glow-b {
    width: 380px;
    height: 380px;
    background: rgba(255, 95, 158, 0.1);
    bottom: -190px;
    right: -110px;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    padding: clamp(2rem, 5vw, 3.75rem) clamp(1.4rem, 4vw, 3.5rem);
  }

  .cta-title {
    font-size: var(--fs-h2);
    margin: 1rem 0 0.85rem;
    max-width: 26rem;
  }

  .cta-sub {
    max-width: 34rem;
    margin-bottom: clamp(1.6rem, 3vw, 2rem);
  }

  .cta-stores {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: 1.6rem;
    border-top: 1px solid var(--c-border);
  }

  .cta-stores-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-dim);
    margin-bottom: 0.9rem;
  }

  /* ══════════════════════ FAQ ══════════════════════ */
  .faq {
    border-top: 1px solid var(--c-border);
  }

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 3.5rem;
    }
    .faq-head {
      margin-bottom: 0;
    }
  }

  .faq-list {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .faq-item {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 0 1.25rem;
    transition: border-color 0.18s ease;
  }

  .faq-item[open] {
    border-color: var(--c-border-strong);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 650;
    font-size: 1rem;
    letter-spacing: -0.015em;
    padding-block: 1.15rem;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-mark {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: rgba(46, 230, 196, 0.12);
  }

  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    inset: 50% 4px auto 4px;
    height: 2px;
    border-radius: 2px;
    background: var(--c-neon);
    transform: translateY(-50%);
    transition: transform 0.2s ease;
  }

  .faq-mark::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .faq-item[open] .faq-mark::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .faq-item > p {
    color: var(--c-text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    padding-bottom: 1.25rem;
    max-width: 44rem;
  }
</style>
